# ==========================================
# TaskPulse Platform Root .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.backup

# Production Builds
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/

# Environment Variables & Secrets (Keep .env.example safe)
.env
*.env
!.env.example
*.env.example
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Database files & local SQLite storage
*.db
*.db-journal
*.sqlite
*.sqlite-journal
backend/dev.db
backend/dev.db-journal
backend/prisma/dev.db
backend/prisma/dev.db-journal

# Uploaded Files & Temporary Storage
uploads/*
backend/uploads/*
!backend/uploads/.gitkeep
*/uploads/*

# Runtime logs
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript build info
*.tsbuildinfo
*/tsconfig.tsbuildinfo
node_modules/.tmp/

# OS and Editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

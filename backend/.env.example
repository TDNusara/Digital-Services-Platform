# TaskPulse Backend Environment Configuration Example
PORT=5000
DATABASE_URL="file:./dev.db" # Or postgresql://user:password@localhost:5432/taskpulse?schema=public
JWT_SECRET="replace-with-a-secure-random-secret-key"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"

# PayHere Gateway Configuration (Sandbox / Production)
PAYHERE_MERCHANT_ID="1211111"
PAYHERE_MERCHANT_SECRET="replace-with-payhere-merchant-secret"
PAYHERE_ENV="sandbox" # or "production"

# Platform Financial Settings
COMMISSION_RATE=0.20
UPLOAD_DIR="./uploads"
